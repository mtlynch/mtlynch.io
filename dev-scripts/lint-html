#!/usr/bin/env bash
set -euo pipefail

# Network checks are a separate, cached Nix build. Always check local HTML/assets.
if [ "$#" -gt 0 ]; then
  echo 'Usage: lint-html' >&2
  exit 1
fi

build_dir="$(realpath public)"
lychee \
  --config lychee-local.toml \
  --offline \
  --root-dir "$build_dir" \
  --remap "^https?://mtlynch\\.io/ file://$build_dir/" \
  --no-ignore \
  -- "$build_dir/**/*.html"
