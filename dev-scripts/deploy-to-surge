#!/usr/bin/env bash
# Usage (after building the site):
#   SURGE_TOKEN='your-token' dev-scripts/deploy-to-surge [--preview|--production]

set -e
set -o pipefail
set -u

usage() {
  printf 'Usage: %s [--preview|--production] [--message MESSAGE]\n' "$0"
}

if [[ $# -eq 1 && "$1" == --help ]]; then
  usage
  exit 0
fi

mode='auto'
case "${1-}" in
  --preview) mode='preview'; shift ;;
  --production) mode='production'; shift ;;
esac

message=''
if [[ $# -eq 2 && "${1-}" == --message && -n "${2-}" ]]; then
  message="$2"
  shift 2
fi

if [[ $# -ne 0 ]]; then
  usage >&2
  exit 1
fi

: "${SURGE_TOKEN:?SURGE_TOKEN must be set}"

if [[ "${mode}" == auto ]]; then
  branch="$(git branch --show-current)"
  if [[ -z "${branch}" ]]; then
    printf 'Cannot select a deployment mode from a detached HEAD.\n' >&2
    exit 1
  fi

  if [[ "${branch}" == master ]]; then
    mode='production'
  else
    mode='preview'
    if [[ -z "${message}" ]]; then
      message="${branch} at $(git rev-parse HEAD)"
    fi
  fi
fi

if [[ "${mode}" == production && -n "${message}" ]]; then
  printf 'Revision messages are only supported for previews.\n' >&2
  usage >&2
  exit 1
fi

surge_args=(
  --project ./public
  --domain https://mtlynch.io
)

if [[ "${mode}" == preview ]]; then
  surge_args+=(--preview)
  if [[ -n "${message}" ]]; then
    surge_args+=(--message "${message}")
  fi
  printf 'Surge preview deployment:\n\n'
else
  printf 'Surge production deployment:\n\n'
fi

surge "${surge_args[@]}"
printf '\n'
