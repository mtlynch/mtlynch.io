#!/usr/bin/env bash
# Usage (after building the site):
#   SURGE_TOKEN='your-token' dev-scripts/deploy-to-surge [--preview|--production]

set -e
set -o pipefail
set -u

usage() {
  printf 'Usage: %s [--preview|--production] [--message MESSAGE] [--production-dir DIR] [--preview-dir DIR] [--help]\n' "$0"
}

mode='auto'
message=''
production_dir='./public'
preview_dir='./public'
while [[ $# -gt 0 ]]; do
  case "$1" in
    --preview|--production)
      if [[ "${mode}" != auto ]]; then
        usage >&2
        exit 1
      fi
      mode="${1#--}"
      shift
      ;;
    --message|--production-dir|--preview-dir)
      if [[ -z "${2-}" || "${2-}" == --* ]]; then
        usage >&2
        exit 1
      fi
      case "$1" in
        --message) message="$2" ;;
        --production-dir) production_dir="$2" ;;
        --preview-dir) preview_dir="$2" ;;
      esac
      shift 2
      ;;
    --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
done

: "${SURGE_TOKEN:?SURGE_TOKEN must be set}"

if [[ "${mode}" == auto ]]; then
  ref="${NIX_CI_GIT_REF:-}"
  if [[ -z "${ref}" ]]; then
    branch="$(git branch --show-current)"
    if [[ -z "${branch}" ]]; then
      printf 'Cannot select a deployment mode from a detached HEAD.\n' >&2
      exit 1
    fi
    ref="refs/heads/${branch}"
  fi

  if [[ "${ref}" == refs/heads/master ]]; then
    mode='production'
  else
    mode='preview'
    if [[ -z "${message}" ]]; then
      commit="$(git rev-parse HEAD)"
      message="${ref} at ${commit}"
    fi
  fi
fi

if [[ "${mode}" == production && -n "${message}" ]]; then
  printf 'Revision messages are only supported for previews.\n' >&2
  usage >&2
  exit 1
fi

project="${production_dir}"
if [[ "${mode}" == preview ]]; then
  project="${preview_dir}"
fi

surge_args=(
  --project "${project}"
  --domain https://mtlynch.io
)

if [[ "${mode}" == preview ]]; then
  surge_args+=(--preview)
  if [[ -n "${message}" ]]; then
    surge_args+=(--message "${message}")
  fi
  printf 'Surge preview deployment:\n\n'
else
  printf 'Surge production deployment:\n\n'
fi

surge "${surge_args[@]}"
printf '\n'
